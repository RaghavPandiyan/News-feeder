# Required for AI summarization
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Reddit API (for Reddit source)
# Create app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=NewsFeeder/1.0

# Optional: NewsAPI (https://newsapi.org free tier)
NEWS_API_KEY=

# Server config
PORT=8000
HOST=0.0.0.0

# Timezone for scheduler (e.g. Asia/Kolkata, America/New_York, UTC)
TIMEZONE=Asia/Kolkata
